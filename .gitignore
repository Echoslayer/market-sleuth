# scenario data (not redistributable — see spec)
/data/
# real scenario JSON served to the frontend must never be committed either;
# only the checked-in toy/dev fixture is allowlisted below
frontend/public/data/*
!frontend/public/data/toy-chipmaker-rally.json

# frontend
frontend/node_modules/
frontend/dist/

# pipeline
pipeline/.venv/
pipeline/.uv-cache/
.uv-cache/
pipeline/*.sqlite
pipeline/*.db
pipeline/__pycache__/
pipeline/**/__pycache__/
*.pyc
# raw curated scenario inputs (real news content) — same copyright concern as /data
pipeline/scenarios/

# OS
.DS_Store

# local agent/session state
.claude/
